{
  "contract_version": "1.0",
  "bundle_id": "eeg-onset-marker-recovery",
  "bundle_revision": "1.1.0",
  "generator_revision": "eeg-marker-generator-1",
  "title": "EEG onset-marker preflight",
  "description": "A deterministic synthetic preflight for the onset-marker route.",
  "simulation_label": "Synthetic EEG apparatus simulation",
  "apparatus": {
    "kind": "eeg",
    "presentation": {
      "montage": ["FC3", "FC4", "FT7", "FT8"],
      "reference": "FCz",
      "ground": "A1",
      "sampling_hz": 1017,
      "online_bandpass_hz": [0.1, 30.0],
      "notch_hz": 50,
      "onset_route": "lower-right simulated optical onset route"
    }
  },
  "observation_schema": {
    "type": "object",
    "properties": {
      "simulation_label": {
        "type": "string",
        "const": "Synthetic EEG apparatus simulation"
      },
      "stage": {"type": "string", "const": "onset_marker_recovery"},
      "summary": {"type": "string", "minLength": 1},
      "onset_timeline": {
        "type": "object",
        "properties": {
          "flash_sequence": {"type": "integer", "minimum": 1},
          "location": {"type": "string", "const": "lower-right"},
          "marker_count": {"type": "integer", "minimum": 1, "maximum": 2},
          "evidence_id": {"type": "string", "pattern": "^flash-[0-9]{3}$"}
        },
        "required": ["flash_sequence", "location", "marker_count", "evidence_id"],
        "additionalProperties": false
      },
      "route_inspection": {
        "type": ["object", "null"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["inspected", "repair_applied"]
          },
          "finding": {"type": "string", "minLength": 1}
        },
        "required": ["status", "finding"],
        "additionalProperties": false
      },
      "freshness": {
        "type": "object",
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^flash-[0-9]{3}$"},
          "evidence_state_revision": {"type": "integer", "minimum": 0},
          "state_revision": {"type": "integer", "minimum": 0},
          "status": {"type": "string", "enum": ["current", "stale"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "required": ["evidence_id", "state_revision", "status"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "stale"}}},
            "then": {"required": ["evidence_state_revision", "reason"]}
          }
        ]
      }
    },
    "required": ["simulation_label", "stage", "summary", "onset_timeline", "freshness"],
    "additionalProperties": false
  },
  "hidden_state_schema": {
    "type": "object",
    "properties": {
      "refractory_route_repaired": {"type": "boolean"},
      "route_inspected": {"type": "boolean"},
      "inspected_before_repair": {"type": "boolean"},
      "repair_transition": {
        "type": ["integer", "null"],
        "minimum": 1
      },
      "flash_sequence": {"type": "integer", "minimum": 1}
    },
    "required": ["refractory_route_repaired", "route_inspected", "inspected_before_repair", "repair_transition", "flash_sequence"],
    "additionalProperties": false
  },
  "actions": [
    {
      "type": "inspect_onset_route",
      "title": "Inspect simulated onset route",
      "description": "Inspect current evidence from the simulated lower-right onset route.",
      "input_schema": {"type": "object", "properties": {}, "additionalProperties": false}
    },
    {
      "type": "repair_refractory_route",
      "title": "Apply targeted simulated repair",
      "description": "Apply the targeted repair to the simulated refractory route.",
      "input_schema": {"type": "object", "properties": {}, "additionalProperties": false}
    },
    {
      "type": "present_test_flash",
      "title": "Present fresh synthetic test flash",
      "description": "Present a fresh synthetic lower-right test flash and observe onset markers.",
      "input_schema": {"type": "object", "properties": {}, "additionalProperties": false}
    },
    {
      "type": "restart_response_handshake",
      "title": "Restart simulated response handshake",
      "description": "Restart the simulated response handshake; this does not alter the onset route.",
      "input_schema": {"type": "object", "properties": {}, "additionalProperties": false}
    }
  ],
  "procedure": {
    "initial_state": "onset_recovery",
    "states": [
      {"id": "onset_recovery", "terminal": false},
      {"id": "evidence_ready", "terminal": true}
    ],
    "transitions": [
      {"id": "inspect-route", "from_state": "onset_recovery", "action": "inspect_onset_route", "to_state": "onset_recovery"},
      {"id": "repair-route", "from_state": "onset_recovery", "action": "repair_refractory_route", "to_state": "onset_recovery"},
      {"id": "test-flash", "from_state": "onset_recovery", "action": "present_test_flash", "to_state": "evidence_ready"},
      {"id": "restart-response", "from_state": "onset_recovery", "action": "restart_response_handshake", "to_state": "onset_recovery"}
    ]
  },
  "split_identities": ["demonstration"],
  "scenarios": [
    {
      "id": "eeg-marker-recovery-001",
      "split": "demonstration",
      "seed": 104729,
      "initial_state": {
        "policy_visible": {
          "simulation_label": "Synthetic EEG apparatus simulation",
          "stage": "onset_marker_recovery",
